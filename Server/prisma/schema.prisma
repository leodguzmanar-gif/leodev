generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String?  // null si solo usa OAuth
  role         String   @default("user") // "user" | "admin"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relaciones
  oauthAccounts OAuthAccount[]
  resetTokens   PasswordResetToken[]
  laboratory    Laboratory[]
  projects      Project[]

  @@map("users")
}

model OAuthAccount {
  id         String @id @default(cuid())
  userId     String
  provider   String // "google" | "github"
  providerId String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("oauth_accounts")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Laboratory {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  content     Json?    // bullets, links, etc.
  status      String   @default("active") // "active" | "in_progress" | "archived"
  tags        String[]
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("laboratory")
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  category    String
  year        Int
  stack       String[]
  status      String   @default("active") // "active" | "in_progress" | "completed" | "prototype"
  links       Json?    // { repo, demo, ... }
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("projects")
}
